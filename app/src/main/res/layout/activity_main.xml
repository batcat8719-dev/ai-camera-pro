<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.aicam.pro.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP ULTRA-CLEAN GEN-Z GLASS HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="40dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:id="@+id/topPillBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="✦ AUTOPILOT V6"
                android:textColor="#CCFF00"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnFlash"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="⚡A"
                android:textColor="#FFD166"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnGemini"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="✦ GEMINI"
                android:textColor="#CCFF00"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSpecs"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="DNA"
                android:textColor="#D4D4D8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:text="● REC 00:00"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="✦ AUTOPILOT FINISHING..."
            android:textColor="#09090B"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCoach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="✦ Autopilot Active — Point &amp; Shoot"
            android:textColor="#F4F4F5"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- BOTTOM ZERO-CLUTTER GEN-Z DECK -->
    <LinearLayout
        android:id="@+id/bottomDeck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="26dp">

        <!-- Optional Manual DSLR Drawer (Hidden in Autopilot) -->
        <LinearLayout
            android:id="@+id/manualPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvIso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="ISO AUTO"
                android:textColor="#CCFF00"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekIso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="20" />

            <TextView
                android:id="@+id/tvShutter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="SHUTTER AUTO"
                android:textColor="#CCFF00"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekShutter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="5" />
        </LinearLayout>

        <!-- Minimal Zoom Pills -->
        <LinearLayout
            android:id="@+id/zoomRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnZ1"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="1x"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnZ15"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="1.5x"
                android:textColor="#D4D4D8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnZ2"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="2x"
                android:textColor="#D4D4D8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnZ3"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="3x"
                android:textColor="#D4D4D8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvZoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="1.0x"
                android:textColor="#A1A1AA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Ultra-Minimal Assist Strip (Only 4 clean pills — everything else is 100% Automatic!) -->
        <LinearLayout
            android:id="@+id/quickPillRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAutoClick"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="HANDS-FREE"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnVoice"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="VOICE"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnAiStudio"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="✦ API"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnDirector"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="✦ TIP"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Clean Mode Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAutopilot"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="✦ AUTOPILOT"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabVideo"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="VIDEO"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabManual"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="MANUAL"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tactile Shutter Row (Gallery | Shutter | Flip) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnGalleryWrap"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/ivGalleryThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Gallery"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <View
                android:layout_width="42dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/btnCaptureOuter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/vCaptureInner"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <View
                android:layout_width="42dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnFlip"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="↻"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
