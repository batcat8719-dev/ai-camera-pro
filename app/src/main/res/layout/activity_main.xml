<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.aicam.pro.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD + AI Coach -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#AA000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="34dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI PRO V4 | Ready"
                android:textColor="#00FFAA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFlash"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="FL:A"
                android:textColor="#FFD54F"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnDirector"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="AI TIP"
                android:textColor="#80D8FF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSpecs"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="DNA"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFlip"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="FLIP"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="#CCDD2C00"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:text="● REC 00:00"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCoach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="#CC111111"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="AI Photographer V4 Active"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#C8000000"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <!-- Row 1: AI Brain Toggles -->
        <LinearLayout
            android:id="@+id/aiToggleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVoice"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="VOICE:ON"
                android:textColor="#00FFAA"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnAutoClick"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="AUTO:ON"
                android:textColor="#00FFAA"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnAutoZoom"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="ZOOM:ON"
                android:textColor="#00FFAA"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnBurst"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="BURST:OFF"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Row 2: V4 Pro Finishing (iPhone Reframe + DSLR Bokeh + Color Look) -->
        <LinearLayout
            android:id="@+id/proFinishRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReframe"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="REFR:OFF"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnBokeh"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="BLUR:OFF"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnLook"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="NATURAL"
                android:textColor="#FFD54F"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Manual DSLR Controls -->
        <LinearLayout
            android:id="@+id/manualPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvIso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISO: Auto"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekIso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="20" />

            <TextView
                android:id="@+id/tvShutter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shutter: Auto"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekShutter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="5" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zoom: 1.0x"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/seekZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />

        <!-- Primary Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPhotoVideo"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="PHOTO"
                android:textSize="11sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.35"
                android:text="CAPTURE"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnMode"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="AI PRO"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
